# ============================================
# ShopAI Backend — Bản mẫu biến môi trường
# Cách dùng: cp .env.example .env rồi điền giá trị thật vào .env
# Không commit file .env.
# ============================================

# Cổng Server lắng nghe. Dùng cùng cổng này trong API_BASE_URL bên Mobile.
PORT=3000

# API key Google Gemini. Lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Bí mật ký JWT. Dùng một chuỗi dài, ngẫu nhiên ở môi trường thật.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite cho môi trường phát triển.
DATABASE_URL="file:./dev.db"
